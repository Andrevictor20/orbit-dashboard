# Copy this file to .env and fill in the values before running on the Raspberry Pi.
# NEVER commit the real .env file — it is listed in .gitignore.

# ── Orbit credentials ─────────────────────────────────────────────────────────
ORBIT_USERNAME=admin
ORBIT_PASSWORD=changeme_use_a_strong_password

# ── JWT secret (generate with: openssl rand -hex 32) ──────────────────────────
JWT_SECRET=replace_me_with_a_secure_random_string

# ── Path on the host where this repo lives (used for compose mounts) ──────────
HOST_PROJECT_PATH=/home/pi/orbit
